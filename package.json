{
  "name": "iotaplayer",
  "productName": "IotaPlayer",
  "private": true,
  "version": "1.5.0",
  "description": "A modern desktop music player focused on local music libraries, seamless playback and a native-feeling interface.",
  "author": {
    "name": "vorlie",
    "url": "https://vorlie.pl"
  },
  "homepage": "https://vorlie.pl/projects/iotaplayer",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "electron .",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "package": "npm run build && electron-forge package --arch=x64",
    "make": "npm run build && electron-forge make --arch=x64",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-discord-rpc.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord-rpc": "^4.0.1",
    "esbuild": "^0.28.2",
    "i18next": "^27.2.1",
    "lucide-react": "^1.48.0",
    "music-metadata": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^18.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/discord-rpc": "^4.0.11",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
